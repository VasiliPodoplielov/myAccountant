rules_version = '2';

// Доступ мають лише власник (uid) і лише з allowlist: документ meta/allowlist { emails: [...] }.
// meta/allowlist клієнту недоступний ні на читання, ні на запис: список веде власник у консолі Firebase.
// Адреси в allowlist зберігати малими літерами.
// Серверні сервіси (firebase-admin) правила обходять, тож ksefInbox пишуть вони.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAllowlisted() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        // get на відсутній документ дає помилку правила, тобто відмову
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/meta/allowlist).data.get('emails', []);
    }

    function isOwner(uid) {
      return request.auth.uid == uid && isAllowlisted();
    }

    // Колекції користувача з повним доступом власника. ksefInbox свідомо не тут.
    function isOwnedCollection(name) {
      return name in [
        'settings', 'documents', 'fixedAssets', 'periods',
        'filings', 'reference', 'vendorRules', 'categoryOverrides', 'fxRates'
      ];
    }

    match /meta/{doc} {
      allow read, write: if false;
    }

    match /users/{uid}/{collection}/{id} {
      allow read, write: if isOwnedCollection(collection) && isOwner(uid);
    }

    // Фактури з KSeF створює й видаляє лише сервіс; користувач міняє тільки status
    match /users/{uid}/ksefInbox/{ksefNumber} {
      allow read: if isOwner(uid);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'accepted', 'ignored'];
    }

    // Усе інше заборонено за замовчуванням
  }
}
