# Приклад /etc/jdg-ledger/ksef-sync.env (права 600, власник jdg). Справжній файл не комітити.

# test — середовище TEST (самопідписаний сертифікат, вигадані дані); demo; prod — справжні фактури
KSEF_ENV=test
# NIP платника, чиї фактури синхронізуються
KSEF_NIP=0000000000
# Сертифікат KSeF типу Authentication і його ключ (PEM), права 600
KSEF_CERT_FILE=/etc/jdg-ledger/ksef-cert.pem
KSEF_KEY_FILE=/etc/jdg-ledger/ksef-key.pem
# Якщо ключ зашифровано: файл з паролем, права 600
#KSEF_KEY_PASSPHRASE_FILE=/etc/jdg-ledger/ksef-key.pass

# Ключ service account Firebase (JSON), права 600
GOOGLE_APPLICATION_CREDENTIALS=/etc/jdg-ledger/firebase-service-account.json
# uid власника у Firebase Auth (консоль Firebase → Authentication → Users)
OWNER_UID=

# Звідки брати фактури при першому запуску: дата (північ за часом Польщі) або ISO date-time.
# Далі сервіс продовжує з точки в users/{uid}/ksefSync/state.
KSEF_SYNC_FROM=2026-02-01
